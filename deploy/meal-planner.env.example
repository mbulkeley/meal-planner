# Production environment for meal-planner. Copy to the repo root as `.env`
# (gitignored) and fill in. Read by systemd via EnvironmentFile= — so plain
# KEY=value, no quotes, no `export`.
#
#   cp deploy/meal-planner.env.example .env && chmod 600 .env
#
# Generate a secret key (URL-safe characters only, so the file can also be
# sourced by bash for `manage.py check --deploy`):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=recipes.mauriecloud.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://recipes.mauriecloud.com
DJANGO_BEHIND_PROXY=true
DJANGO_TIME_ZONE=Europe/Amsterdam
# DJANGO_LOG_LEVEL=INFO
